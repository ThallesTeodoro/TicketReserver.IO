{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=ticketing_db;Username=user;Password=password;Include Error Detail=true",
    "CommandTimeoutSeconds": 30
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "TicketsIssuedTopic": "ticketing.v1.issued",
    "TicketingFailedTopic": "ticketing.v1.failed",
    "DeadLetterQueueTopic": "payment.v1.approved.DLQ",
    "ClientId": "tr-hw-ticketing-producer",
    "MessageTimeoutMs": 10000
  },
  "KafkaConsumer": {
    "BootstrapServers": "localhost:9092",
    "Topic": "payment.v1.approved",
    "GroupId": "cg-ticketing-worker",
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false,
    "SessionTimeoutMs": 45000,
    "MaxPollIntervalMs": 300000,
    "DeadLetterQueueTopic": "payment.v1.approved.DLQ"
  },
  "TicketingSecurity": {
    "QrCodeSecretKey": "ticketreserver-default-hmac-secret-key-2026-anti-fraud"
  }
}
