{
  "ConnectionStrings": {
    "ReservationDb": "Host=postgres;Port=5432;Database=reservation_db;Username=postgres;Password=postgres",
    "Redis": "redis:6379"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "Topic": "reservation.v1.hold_created.delayed",
    "GroupId": "cg-reservation-timeout",
    "DeadLetterQueueTopic": "reservation.v1.hold_created.delayed.DLQ",
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false,
    "MaxPollIntervalMs": 300000,
    "SessionTimeoutMs": 45000
  },
  "Database": {
    "CommandTimeoutSeconds": 30
  },
  "Redis": {
    "DefaultDatabase": 0,
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
