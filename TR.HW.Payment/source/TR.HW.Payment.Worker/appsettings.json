{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=payment_db;Username=user;Password=password;Include Error Detail=true",
    "CommandTimeoutSeconds": 30
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PaymentApprovedTopic": "payment.v1.approved",
    "PaymentDeclinedTopic": "payment.v1.declined",
    "DeadLetterQueueTopic": "payment.v1.checkout_req.DLQ",
    "ClientId": "tr-hw-payment-producer",
    "MessageTimeoutMs": 10000
  },
  "KafkaConsumer": {
    "BootstrapServers": "localhost:9092",
    "Topic": "reservation.v1.checkout_req",
    "GroupId": "cg-payment-processing",
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false,
    "SessionTimeoutMs": 45000,
    "MaxPollIntervalMs": 300000,
    "DeadLetterQueueTopic": "reservation.v1.checkout_req.DLQ"
  },
  "PaymentGateway": {
    "Provider": "STRIPE",
    "ApiKey": "test_key",
    "BaseUrl": "https://api.stripe.com",
    "SimulateSuccess": true,
    "MaxRetries": 3
  }
}
