      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(ticketreserver_saga_events_total{topic=\"payment.v1.approved\"}[1m]))",
          "legendFormat": "payment.v1.approved",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(ticketreserver_saga_events_total{topic=\"ticketing.v1.issued\"}[1m]))",
          "legendFormat": "ticketing.v1.issued",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(ticketreserver_saga_events_total{topic=\"ticketing.v1.failed\"}[1m]))",
          "legendFormat": "ticketing.v1.failed",
          "refId": "C"
        }
      ],
      "title": "Saga Completion vs Failure Rates",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(ticketreserver_seat_collision_refunds_total[1m]))",
          "legendFormat": "Auto-Refund Compensations",
          "refId": "A"
        }
      ],
      "title": "Seat Collision Detected & Compensated (TR.HW.Refund)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
