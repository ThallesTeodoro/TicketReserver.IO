{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "KafkaConsumer": {
    "BootstrapServers": "localhost:9092",
    "Topics": [
      "ticketing.v1.issued",
      "payment.v1.refunded",
      "payment.v1.declined"
    ],
    "GroupId": "cg-notification-worker",
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false,
    "SessionTimeoutMs": 45000,
    "MaxPollIntervalMs": 300000
  },
  "NotificationInfrastructure": {
    "RedisConnectionString": "localhost:6379,abortConnect=false",
    "InboxRetentionDays": 7,
    "RetryCount": 3,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30
  }
}
