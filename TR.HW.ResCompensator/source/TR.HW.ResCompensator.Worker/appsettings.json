{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=reservation_db;Username=user;Password=password;Include Error Detail=true",
    "CommandTimeoutSeconds": 30
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  },
  "KafkaConsumer": {
    "BootstrapServers": "localhost:9092",
    "Topics": [
      "payment.v1.refunded",
      "payment.v1.declined",
      "ticketing.v1.issued"
    ],
    "GroupId": "cg-reservation-compensator",
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false,
    "SessionTimeoutMs": 45000,
    "MaxPollIntervalMs": 300000,
    "DeadLetterQueueTopic": "payment.v1.refunded.DLQ"
  }
}
