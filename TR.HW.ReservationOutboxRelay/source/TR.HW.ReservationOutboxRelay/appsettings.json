{
  "ConnectionStrings": {
    "ReservationDb": "Host=postgres;Port=5432;Database=reservation_db;Username=postgres;Password=postgres"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "CheckoutTopic": "reservation.v1.checkout_req",
    "HoldCreatedDelayedTopic": "reservation.v1.hold_created.delayed",
    "DeadLetterQueueTopic": "reservation.v1.checkout_req.DLQ",
    "ClientId": "tr-hw-reservation-outbox-relay",
    "MessageTimeoutMs": 10000
  },
  "OutboxRelay": {
    "BatchSize": 50,
    "IntervalMilliseconds": 500,
    "EmptyDelayMilliseconds": 1000,
    "MaxRetries": 5,
    "RetryBaseDelaySeconds": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
